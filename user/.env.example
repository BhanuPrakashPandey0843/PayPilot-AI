# Currency Symbol
NEXT_PUBLIC_CURRENCY_SYMBOL = '$'

# Base URL of the chatbot app (backend/chatbot) that the floating chat
# widget embeds in an iframe. Run backend/chatbot on its own port (it
# defaults to 3000, same as this app) — set PORT=3001 in
# backend/chatbot/.env for local dev to avoid a clash.
NEXT_PUBLIC_CHATBOT_URL = 'http://localhost:3001'
