# Copy this file to .env and fill in real values.
# Never commit the real .env file.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Postgres connection string (used by `postgres` + drizzle-orm)
# Example local:  postgresql://user:password@localhost:5432/paypilot
# Example Neon:   postgresql://user:pass@ep-xxx.neon.tech/paypilot?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/paypilot

# Redis connection string (used by ioredis).
# Reserved for future catalog caching + rate-limiting; not yet wired into routes.
REDIS_URL=redis://localhost:6379

# JWT signing secret (used by @fastify/jwt).
# MUST be at least 16 chars. Use `openssl rand -hex 32` (or similar) in production.
JWT_SECRET=replace-with-a-long-random-secret

# JWT access token lifetime — @fastify/jwt "expiresIn" format.
# Examples: "15m", "1h", "7d", "30d".
# Shorter lifetimes + refresh tokens are recommended for production.
JWT_EXPIRES_IN=7d

# Razorpay test-mode API keys (https://dashboard.razorpay.com/app/keys)
# Required for checkout (POST /api/v1/checkout/create-order,
# POST /api/v1/checkout/verify-payment) to actually call Razorpay.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay webhook signing secret — set this on the Razorpay Dashboard
# under Settings > Webhooks when you register the webhook URL
# (POST /api/v1/webhooks/razorpay). This is NOT the same value as
# RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Allowed origin for CORS (the frontend URL)
CORS_ORIGIN=http://localhost:3000
