# Copy this file to .env and fill in real values.
# Never commit the real .env file.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Postgres connection string (used by `postgres` + drizzle-orm)
DATABASE_URL=postgresql://user:password@localhost:5432/paypilot

# Redis connection string (used by ioredis)
REDIS_URL=redis://localhost:6379

# JWT signing secret (used by @fastify/jwt) — use a long random string
JWT_SECRET=replace-with-a-long-random-secret

# Razorpay test-mode API keys (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Allowed origin for CORS (the frontend URL)
CORS_ORIGIN=http://localhost:3000
