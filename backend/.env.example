# Copy this file to .env and fill in real values.
# Never commit the real .env file.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Postgres connection string (used by `postgres` + drizzle-orm)
# Example local:  postgresql://user:password@localhost:5432/paypilot
# Example Neon:   postgresql://user:pass@ep-xxx.neon.tech/paypilot?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/paypilot

# Redis connection string (used by ioredis).
# Backs the rate limiter on checkout/verify-payment/webhook/AI-execute routes
# (src/middleware/rateLimit.ts). Fails OPEN if unreachable, so it's safe to
# leave pointed at a local/dev Redis without breaking checkout.
REDIS_URL=redis://localhost:6379

# JWT signing secret (used by @fastify/jwt).
# MUST be at least 16 chars. Use `openssl rand -hex 32` (or similar) in production.
JWT_SECRET=replace-with-a-long-random-secret

# JWT access token lifetime — @fastify/jwt "expiresIn" format.
# Examples: "15m", "1h", "7d", "30d".
# Shorter lifetimes + refresh tokens are recommended for production.
JWT_EXPIRES_IN=7d

# Razorpay test-mode API keys (https://dashboard.razorpay.com/app/keys)
# Required for checkout (POST /api/v1/checkout/create-order,
# POST /api/v1/checkout/verify-payment) to actually call Razorpay.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay webhook signing secret — set this on the Razorpay Dashboard
# under Settings > Webhooks when you register the webhook URL
# (POST /api/v1/webhooks/razorpay). This is NOT the same value as
# RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Allowed origin for CORS (the frontend URL)
CORS_ORIGIN=http://localhost:3000

# --- Milestone 6: AI Revenue Copilot ---
# Both optional. Set AT MOST ONE. With neither set, the AI explanation/
# copilot layer falls back to deterministic template text instead of
# failing (analytics + revenue opportunities still work with zero AI
# configuration; ANTHROPIC_API_KEY takes priority if both are set).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Deterministic, documented thresholds for the revenue opportunity engine.
ABANDONED_CHECKOUT_THRESHOLD_MINUTES=180
REVENUE_DROP_THRESHOLD_PERCENT=10
MIN_CROSS_SELL_SAMPLE_SIZE=5

# Phase 9 policy engine — max estimatedRevenueImpact (integer minor units)
# auto-executable via POST /api/v1/revenue/opportunities/:id/execute.
# Above this, the opportunity can still be approved but not auto-executed.
# Default 10000000 = ₹1,00,000.
REVENUE_ACTION_MAX_AMOUNT_MINOR=10000000
