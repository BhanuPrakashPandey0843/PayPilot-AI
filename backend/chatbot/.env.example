# Copy this file to .env and fill in real values. Never commit the real .env.

# --- OpenAI (agent reasoning / tool-calling loop) ---
OPENAI_API_KEY=jkskkx

# --- PayPilot AI backend integration ---
# The chatbot no longer has its own product/basket/order database — every
# catalog lookup, cart mutation, and checkout goes through the real
# PayPilot AI backend (backend/src) over HTTP. See
# app/services/paypilot_api_client.rb.

# Base URL of the PayPilot AI backend's v1 API. Default matches PayPilot's
# own backend/.env.example (PORT=4000).
PAYPILOT_API_BASE_URL=http://localhost:4000/api/v1

# Service-account credentials the chatbot logs in as (POST /auth/login) to
# call the PayPilot API. This must be a real user in the PayPilot backend's
# own database — create one via POST /auth/register on that backend (or
# through its own signup flow) BEFORE starting this app. The chatbot is an
# anonymous, session-based widget with no login of its own, so every buyer
# session shares this one organization/service-account identity — carts
# and conversation history are still kept separate per browser session_id,
# but products/checkout all happen against this one PayPilot organization.
PAYPILOT_SERVICE_EMAIL=chatbot@yourorg.example
PAYPILOT_SERVICE_PASSWORD=replace-with-that-users-real-password

# --- Rails ---
# RAILS_MAX_THREADS=5
